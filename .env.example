# ===== 前端环境变量模板 =====
# 复制为 .env 后由 install.sh 自动填充实际值；切勿手工填入正式密钥后提交仓库。

# Supabase 站点 URL（不含末尾斜杠）
VITE_SUPABASE_URL=https://your-domain.com

# Supabase 匿名 key（anon role JWT）。由 install.sh 在部署 Supabase 时自动生成并写入此文件。
# 该密钥公开，不视为机密，但建议定期轮换。
VITE_SUPABASE_ANON_KEY=__SUPABASE_ANON_KEY__

# 应用标识（可选）
VITE_APP_ID=miaoda-mall